<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="chatScrollPane" id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true" style="-fx-background: #1f1f1f; -fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <content>
      <VBox fx:id="messagesBox" id="messagesBox" fillWidth="true" spacing="18.0" style="-fx-background-color: #1f1f1f;">
         <padding>
            <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
